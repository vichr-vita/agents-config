{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "nibomo_*": "deny"
  },
  "mcp": {
    "nibomo": {
      "type": "remote",
      "url": "https://vichr-rbpi5.tailb8724c.ts.net:10443/v1/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/nibomo-mcp-key}"
      }
    }
  }
}
